# Supabase PostgreSQL Connection String
# Example formats:
# Direct connection (Session mode, port 5432):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# Connection Pooler (Transaction mode, port 6543):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@localhost:5432/algolens

# Security & JWT Configuration
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-generate-with-secrets-token-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application settings
ENVIRONMENT=development
LOG_LEVEL=info

# AI Assistant (Phase 10 — Google Gemini) — leave blank to disable the /api/ai/ask endpoint
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
# Optional OpenAI fallback
# OPENAI_API_KEY=sk-your-openai-key-here
